<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FrameLink.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      Run the suite by executing this project directly (`dotnet run` pointed at
      tests/FrameLink.Tests), not with `dotnet test`.

      xunit v3 test projects are executables whose entry point IS the runner, so `dotnet run`
      is the documented path and it reports proper exit codes (0 pass, non-zero fail). As of
      xunit.v3 4.0.0 on the .NET 10 SDK, `dotnet test` additionally negotiates over the
      Microsoft.Testing.Platform v2 bridge and discovers nothing — it reports "Zero tests ran"
      against an assembly that runs all of them directly. The harness therefore calls
      `dotnet run`, which is one less moving part between a change and its verdict.

      Also note the property that must NOT be set here: TestingPlatformDotnetTestSupport
      imports the VSTest override targets, and VSTest is the path the .NET 10 SDK refuses
      outright.
    -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>

    <!-- The test host is not published AOT, and the analysers would flag the runner's own
         reflection rather than anything in the code under test. The projects being tested
         keep the analysers on, which is where the constraint actually needs enforcing. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- §7.1 "Everything floats, the build freezes it": dependencies resolve to latest at
       restore time and are frozen into the artifact by the lock the build produces.
       Nothing here is pinned to work around a break. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FrameLink.Protocol\FrameLink.Protocol.csproj" />
    <ProjectReference Include="..\..\src\FrameLink.Control\FrameLink.Control.csproj" />
    <ProjectReference Include="..\..\src\FrameLink.Agent\FrameLink.Agent.csproj" />
    <!-- §7.1's upstream review ledger. The tool owns the probes, which reach the network and
         therefore never run here; what the suite asserts is the offline half — that the committed
         ledger is sound and still describes the pins in source. -->
    <ProjectReference Include="..\..\tools\FrameLink.Upstream\FrameLink.Upstream.csproj" />
    <!-- Mn+3's parity harness. Same split, same reason: the tool owns the comparison and the
         ledger, tools/harness/fl.py owns reaching the frame, and this reference is what puts
         the whole verdict path — parsers, differ, ledger, coverage — inside the ordinary
         suite with no hardware anywhere near it. -->
    <ProjectReference Include="..\..\tools\FrameLink.Parity\FrameLink.Parity.csproj" />
  </ItemGroup>

</Project>
