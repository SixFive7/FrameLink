<Project>

  <!--
    Shared build settings for every FrameLink v2 project.

    Two project policies from version2.md are enforced here rather than per-project,
    so that a new project cannot silently opt out of them:

      §7.1 "Everything floats, the build freezes it" — no global.json, no pinned SDK
           band. Dependencies resolve at build time and are frozen into the artifact.

      §7.2 "Analyzers run at error severity and are never weakened to make code pass."
           TreatWarningsAsErrors makes every analyser diagnostic build-breaking.
           AnalysisLevel is 'latest-recommended' rather than 'latest-all' deliberately:
           the -all set adds rules whose only realistic resolution at this size is bulk
           suppression, and bulk suppression IS the weakening §7.2 forbids.

           What 'latest-recommended' does NOT do is spare this codebase the
           micro-performance rules. CA1848 (use LoggerMessage delegates) is in the
           recommended set and fired at error severity across the Fleet Manager, and the
           resolution was to move every call site to source-generated [LoggerMessage] —
           see ControlLog.cs, which also picks up CA1873 on the boxed-argument overload.
           That is the outcome §7.2 wants: the rule was satisfied, not silenced. Anything
           later reading this as "recommended avoids the fiddly rules" will be wrong.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    §2.8's updater MATCHES the served version string against the one the binary reports; it
    never compares them. That makes an informational version a wire value, and the SDK must
    not decorate it.

    By default the SDK appends '.$(SourceRevisionId)' to InformationalVersion even when the
    build sets that property explicitly, so a release published as 0.0.0+a273b31 reports
    itself as 0.0.0+a273b31.<40-char-sha>. Those can never be equal, so every frame downloads
    the binary it is already running, swaps it, restarts, and does it again an hour later —
    fleet wide, forever, presenting only as "the frames restart every hour".

    Repo-wide rather than in the agent project, and that placement is the fix rather than
    tidiness. build.sh passes -p:InformationalVersion, which is a GLOBAL property and therefore
    reaches every project in the graph. With the opt-out set only on FrameLink.Agent,
    FrameLink.Protocol was still stamped with the decorated string and — being linked into the
    single AOT binary — carried it into the shipped ELF. The agent's own attribute happened to
    be right, but the value was one project away from being wrong with nothing to say so.
  -->
  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Undocumented public member. The agent and control apps are executables, not
         libraries; XML docs on every public symbol there is ceremony, not safety.
         FrameLink.Protocol re-enables it, because that IS the published contract. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Native AOT is the delivery format for both programs (§2.1, §3.1), so every
       project is held to AOT-compatibility rules even when it is not itself published
       AOT. IL2026/IL3050 then fire at compile time, which is what forces the
       source-generated JSON contract instead of reflection. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <PropertyGroup>
    <Product>FrameLink</Product>
    <Company>FrameLink</Company>
    <Copyright>Copyright (c) Jori Huisman</Copyright>

    <!--
      Bespoke five-year FSL variant (§7.3). Never the bare FSL-1.1-MIT identifier.

      It has to be PackageLicenseFile, not PackageLicenseExpression. NuGet documents
      PackageLicenseExpression as taking "an SPDX license identifier or expression", and
      PackageLicenseFile as the property "if you're using a custom license or a license
      that hasn't been assigned an SPDX identifier" — which is exactly what
      LicenseRef-FrameLink-FSL-1.1-MIT-5yr is. Putting the LicenseRef in the expression
      property is not merely untidy: pack fails it as NU5124 "the license identifier is
      not recognized by the current toolset", and with TreatWarningsAsErrors on that is a
      build break the moment anything is packed.
    -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <!--
    PackageLicenseFile only names the path inside the package; the file still has to be
    put there. The explicit item is doubly required here because LICENSE has no
    extension, and NuGet/MSBuild treat an extensionless path as a directory — the
    "packing a file without an extension" case, whose documented remedy is precisely this
    None item. MSBuildThisFileDirectory anchors it to the repository root rather than to
    each project's own directory.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
