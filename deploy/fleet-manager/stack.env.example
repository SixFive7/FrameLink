# FrameLink Fleet Manager — the values framelink.stack.yml asks for.
#
# ── THIS FILE IS A TEMPLATE AND MUST STAY ONE ────────────────────────────────────────────────
# It is committed. Nothing in it is a real value, and nothing secret may ever be written into it
# — not the operator password, not an alert token, not a LiveKit secret. Repository rule §1.2 is
# categorical about credentials in committed artifacts, and the Fleet Manager gives that rule
# somewhere to land: §3.2 takes the password from an environment variable only, so the variable
# is the credential and the place it is typed is the deployment tool.
#
# ── WHERE THE REAL VALUES GO ─────────────────────────────────────────────────────────────────
# Portainer → your stack → Environment variables. Portainer holds them in its own database and
# re-supplies them on every redeploy, so a redeploy needs nobody to remember anything and no file
# on the Docker host holds a password. Copy the names below into that panel; do not copy this
# file onto the host as a .env.
#
# Docker Compose `secrets:` was considered and is not used. Its file-backed form needs the secret
# written to a file on the host, which is precisely what §1.2 forbids, and its Swarm form needs a
# Swarm. An environment variable read once at start-up, from a store that already exists, is both
# fewer moving parts and a smaller footprint on disk: none.
#
# ── ROTATING THE PASSWORD ────────────────────────────────────────────────────────────────────
# Change it in Portainer and redeploy the stack. There is no password file, no hash on disk and
# no first-run wizard to undo — the variable IS the credential (§3.2), so rotation is a restart.
# Frames are unaffected: /agent is exempt from the password and authenticates by keypair.

# ─────────────────────────────────────────────────────────────────────────────────────────────
# REQUIRED — the deployment refuses to be useful without these
# ─────────────────────────────────────────────────────────────────────────────────────────────

# The image tag to run. ALWAYS an immutable tag, never `:latest` — this value is the whole of the
# rollback story (docs/14, step 8), and a moving tag makes "run the previous one" unanswerable.
# Produced by deploy/fleet-manager/build-image.sh, which prints it on the last line.
FRAMELINK_IMAGE=framelink/fleet-manager:0.0.0-0000000

# The operator password (§3.2, decision 43). One operator, no accounts, no roles. Minimum 24
# characters, enforced at start-up: below that the instance stays unconfigured and says why,
# because this login is reachable from the internet.
#   Generate one:  openssl rand -base64 33
FRAMELINK_OPERATOR_PASSWORD=

# The public name. Must already resolve to this Docker host and be covered by the certificate
# resolver named below.
FRAMELINK_DOMAIN=framelink.huisman.io

# Traefik's certificate resolver, as that stack names it.
FRAMELINK_CERT_RESOLVER=letsencrypt

# The Authelia forward-auth middleware, as that stack names it, in Traefik's
# `<name>@<provider>` form. It guards the GUI and never /agent (§3.8).
FRAMELINK_GUI_MIDDLEWARES=authelia@docker

# This stack's own /24, from the PortainerCompose repo's config/networks.yaml — never invented
# here, because that file is what stops two stacks claiming one subnet.
FRAMELINK_NETWORK_NAME=framelink
FRAMELINK_SUBNET=172.16.20.0/24
FRAMELINK_IPV4=172.16.20.10

# §3.8's MAC convention: `02:42:` followed by the IPv4 octets in hex. 172.16.20.10 is
# ac:10:14:0a, so the pinned MAC is 02:42:ac:10:14:0a. Pinned so that a container recreated by a
# redeploy is the same L2 identity to anything that has learned it.
FRAMELINK_MAC=02:42:ac:10:14:0a

# The one inbound pinhole this stack needs: Traefik to the GUI/agent port. Everything else stays
# closed, and this stack asks for no outbound reach into another stack's /24.
FRAMELINK_DFW_RULES=allow from traefik to 172.16.20.10 port 8080/tcp

# Traefik's address on the bridge it reaches this stack from. The per-IP rate limiter on the open
# registration path (§3.3) believes X-Forwarded-For from this address and from no other; leave it
# empty and every request on earth shares one budget, set it too widely and the budget is
# forgeable. Comma-separated if Traefik has more than one address.
FRAMELINK_TRUSTED_PROXIES=172.16.20.1

# The signalling address frames dial for calls (§3.7). The Docker host's LAN address, not the
# domain: media is published on the host directly and cannot go through Traefik, so the frames
# and the server have to agree on an address that reaches the host.
FRAMELINK_LIVEKIT_PUBLIC_URL=ws://10.20.30.250:7880

# ─────────────────────────────────────────────────────────────────────────────────────────────
# OPTIONAL — every one of these has a working default
# ─────────────────────────────────────────────────────────────────────────────────────────────

# Where §3.5's alerts are POSTed as JSON. A Home Assistant webhook, which is decision 22's
# "already wired here, no new credentials" — an unguessable URL an automation triggers on, with
# no token to mint or rotate. Unset means alerts go to the container log and no further.
# FRAMELINK_ALERT_WEBHOOK=http://10.20.30.250:8123/api/webhook/framelink-alerts

# A bearer token for a receiver that wants one. SECRET — if you use it, it goes in Portainer
# beside the password and never here.
# FRAMELINK_ALERT_TOKEN=

# Alerting thresholds. The defaults are 30 minutes out of contact, 30 days of remaining call
# credential, a 5-minute evaluation interval and a 15-minute start-up grace before the call
# server's absence is reported.
# FRAMELINK_ALERT_OFFLINE_MINUTES=30
# FRAMELINK_ALERT_EXPIRY_DAYS=30
# FRAMELINK_ALERT_INTERVAL_MINUTES=5
# FRAMELINK_ALERT_CALL_GRACE_MINUTES=15

# Which host address the LiveKit ports are published on. The default binds every interface, which
# is what a LAN deployment needs. Narrow it to the LAN address if this host also has an interface
# calls should never arrive on.
# FRAMELINK_LIVEKIT_BIND=0.0.0.0

# Traefik entrypoint. `websecure` unless that stack names it otherwise.
# FRAMELINK_ENTRYPOINT=websecure

# The data volume's name. Changing it points this stack at a DIFFERENT fleet database — every
# adopted frame would reappear as a stranger in the adoption queue (§3.3). Change it only when
# that is the intention.
# FRAMELINK_VOLUME=framelink-data

# §3.9's generated images. They are 3 GB each and default to living inside the data volume, whose
# free space the database also depends on. Point this at a second mount if that volume is small;
# the free-space check refuses a build rather than half-writing one either way.
# FRAMELINK_IMAGE_DIR=/var/lib/fl-control/images

# Point the Fleet Manager at an existing LiveKit instead of the bundled one (§3.7's escape
# hatch). Setting the URL is what switches modes; the key and secret then become required, and
# the secret is a SECRET — Portainer, not here.
# FRAMELINK_LIVEKIT_URL=ws://10.20.30.250:7880
# FRAMELINK_LIVEKIT_API_KEY=
# FRAMELINK_LIVEKIT_API_SECRET=
