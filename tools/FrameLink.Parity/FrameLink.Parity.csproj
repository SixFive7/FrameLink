<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The parity harness's judge (version2.md §5.1, milestone Mn+3).

    A development tool, never shipped and never invoked by a build. It answers one
    question — is this frame at parity with the frozen v1 reference, and if not, exactly
    where does it differ — from a state observation somebody collected off a live frame.

    Split the same way tools/FrameLink.Upstream is split, for the same reason. Everything
    that reaches the frame lives outside the suite (tools/harness/flh/parity.py, paramiko
    per CLAUDE.md §1.3); everything that decides what an observation *means* lives here and
    runs inside the ordinary suite against fixtures. tests/FrameLink.Tests references this
    project, which is what makes the whole verdict path testable with no hardware.

    It references FrameLink.Control on purpose: package drift is already computed there,
    against the same 929-package v1 baseline, by the code the Fleet Manager uses on every
    inventory report (decision 55). A second implementation of "is this version newer" is
    exactly the thing that would eventually disagree with the product.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FrameLink.Parity</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FrameLink.Protocol\FrameLink.Protocol.csproj" />
    <ProjectReference Include="..\..\src\FrameLink.Control\FrameLink.Control.csproj" />
  </ItemGroup>

</Project>
